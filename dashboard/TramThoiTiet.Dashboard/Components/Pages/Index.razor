@page "/"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@using System.Text.Json
@using TramThoiTiet.Dashboard.Services
@inject WeatherStore Store
@inject OpenMeteoService OpenMeteo
@inject HistoryService History
@inject AiAdviceService Ai
@inject IJSRuntime JS
@implements IDisposable

<h3>Trạm thời tiết mini</h3>
<div class="d-flex gap-2 align-items-center mb-2">
    <span class="badge @(Store.MqttConnected ? "bg-success" : "bg-danger")">MQTT @(Store.MqttConnected ? "đã kết nối" : "chưa kết nối")</span>
    @if (Store.Latest is { } s)
    {
        <span class="badge @(s.SensorOk ? "bg-success" : "bg-danger")">Cảm biến @(s.SensorOk ? "hoạt động" : "lỗi")</span>
        <span class="text-muted small">@s.Device · @(s.ReceivedAt.ToString("HH:mm:ss"))</span>
    }
</div>

<div class="d-flex gap-2 align-items-center mb-4">
    <span class="fs-5">@(_place is null ? "Đang xác định vị trí…" : $"Vị trí của bạn: {_place}")</span>
    <span class="text-muted small">@(_coords is null ? "" : $"({_coords.Value.lat:0.####}, {_coords.Value.lon:0.####})")</span>
    <button class="btn btn-outline-primary btn-sm" @onclick="UseMyLocation">Lấy vị trí hiện tại</button>
    @if (_api is not null)
    {
        <span class="text-muted small">Open-Meteo cập nhật @(_api.Time.ToString("HH:mm"))</span>
    }
</div>

@if (OpenMeteo.Forecast.Count > 1)
{
    <h5 class="mb-2">Dự báo các ngày tới</h5>
    <div class="row g-2 mb-4">
        @foreach (var day in OpenMeteo.Forecast.Skip(1))
        {
            <div class="col-6 col-md">
                <div class="metric-tile">
                    <div class="fw-semibold">@DayLabel(day.Date)</div>
                    <div class="metric-value">@($"{day.TempMin:0.#}–{day.TempMax:0.#}°C")</div>
                    <div>@OpenMeteoService.DescribeWeatherCode(day.WeatherCode)</div>
                    <div class="text-muted small">Mưa @($"{day.PrecipitationSum:0.#} mm ({day.PrecipitationProbability}%)")</div>
                </div>
            </div>
        }
    </div>
}

@if (Store.Latest is { } latest)
{
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card h-100 current-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">Thời tiết hiện tại — trạm</span>
                        <span class="badge @(latest.SensorOk ? "bg-success" : "bg-danger")">@(latest.SensorOk ? "Cảm biến hoạt động" : "Cảm biến lỗi")</span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-3">
                        <span class="current-temp">@Fmt(latest.NhietDo)</span>
                        <span class="fs-4 text-muted">°C</span>
                    </div>
                    <div class="row g-2 metric-grid">
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@Fmt(latest.DoAm)</div><div class="metric-label">Độ ẩm (%)</div></div></div>
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@Fmt(latest.TocDoGio)</div><div class="metric-label">Gió (m/s)</div></div></div>
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@Compass(latest.HuongGio) @latest.HuongGio°</div><div class="metric-label">Hướng gió</div></div></div>
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@Fmt(latest.Mua)</div><div class="metric-label">Mưa (mm/h)</div></div></div>
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@Fmt(latest.AnhSang)</div><div class="metric-label">Ánh sáng (lx)</div></div></div>
                        <div class="col-6 col-md-4"><div class="metric-tile"><div class="metric-value">@(latest.ReceivedAt.ToString("HH:mm:ss"))</div><div class="metric-label">Cập nhật</div></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100 current-card">
                <div class="card-body">
                    @if (_api is { } api)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">Open-Meteo</span>
                            <span class="badge bg-secondary">@(api.Time.ToString("HH:mm"))</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="current-temp">@Fmt(api.Temperature)</span>
                            <span class="fs-4 text-muted">°C</span>
                        </div>
                        <div class="row g-2 metric-grid mb-3">
                            <div class="col-6"><div class="metric-tile"><div class="metric-value">@Fmt(api.Humidity)</div><div class="metric-label">Độ ẩm (%)</div></div></div>
                            <div class="col-6"><div class="metric-tile"><div class="metric-value">@Fmt(api.WindSpeed)</div><div class="metric-label">Gió (m/s)</div></div></div>
                            <div class="col-6"><div class="metric-tile"><div class="metric-value">@Compass(api.WindDirection) @api.WindDirection°</div><div class="metric-label">Hướng gió</div></div></div>
                        </div>
                        @if (OpenMeteo.Forecast is { } f && f.Count > 0)
                        {
                            <div class="metric-tile today-tile">
                                <div class="fw-semibold mb-1">Hôm nay</div>
                                <div>@($"{f[0].TempMin:0.#}–{f[0].TempMax:0.#}°C") · @OpenMeteoService.DescribeWeatherCode(f[0].WeatherCode)</div>
                                <div class="text-muted small">Mưa @($"{f[0].PrecipitationSum:0.#} mm ({f[0].PrecipitationProbability}%)")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">Open-Meteo</span>
                        </div>
                        <p class="text-muted mb-0">Chưa có dữ liệu API.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (AdviceFor(latest) is { } advice && advice.Score is not null)
    {
        <div class="d-flex gap-2 align-items-center mb-3">
            <span class="badge @(advice.Level == "Thuận lợi" ? "bg-success" : advice.Level == "Bình thường" ? "bg-warning text-dark" : "bg-danger")">@advice.Level</span>
            <span>@advice.Comment</span>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold">Nhận xét AI</span>
                <button class="btn btn-sm btn-primary" @onclick="GenerateAiAdviceAsync" disabled="@_aiLoading">Nhận xét</button>
            </div>
            @if (_aiLoading)
            {
                <div class="d-flex align-items-center gap-2" aria-live="polite">
                    <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Đang tải…</span></div>
                    <span>Đang sinh nhận xét…</span>
                </div>
            }
            else if (_aiText is { } aiText)
            {
                <span>@aiText</span>
            }
            else if (_aiStatus == AiAdviceStatus.NotConfigured)
            {
                <span class="text-muted">Chưa cấu hình API key — dán key vào <code>Ai:ApiKey</code> trong appsettings.json.</span>
            }
            else if (_aiStatus == AiAdviceStatus.Failed)
            {
                <span class="text-danger">Không tạo được nhận xét, thử lại sau.</span>
            }
            else
            {
                <span class="text-muted">Bấm Nhận xét để AI đọc số liệu hiện tại và đưa ra đánh giá.</span>
            }
        </div>
    </div>

    <table class="table table-striped w-auto">
        <thead>
            <tr>
                <th>Chỉ số</th>
                <th>Trạm</th>
                <th>Open-Meteo</th>
                <th>Chênh lệch</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Nhiệt độ (°C)</td><td>@Fmt(latest.NhietDo)</td><td>@Fmt(_api?.Temperature)</td><td>@Delta(latest.NhietDo, _api?.Temperature)</td></tr>
            <tr><td>Độ ẩm (%)</td><td>@Fmt(latest.DoAm)</td><td>@Fmt(_api?.Humidity)</td><td>@Delta(latest.DoAm, _api?.Humidity)</td></tr>
            <tr><td>Gió (m/s)</td><td>@Fmt(latest.TocDoGio)</td><td>@Fmt(_api?.WindSpeed)</td><td>@Delta(latest.TocDoGio, _api?.WindSpeed)</td></tr>
            <tr><td>Hướng gió</td><td>@Compass(latest.HuongGio) (@latest.HuongGio°)</td><td>@(_api is null ? "" : $"{Compass(_api.WindDirection)} ({_api.WindDirection}°)")</td><td>@DeltaDeg(latest.HuongGio, _api?.WindDirection)</td></tr>
            <tr><td>Mưa (mm/h)</td><td>@Fmt(latest.Mua)</td><td>–</td><td>–</td></tr>
            <tr><td>Ánh sáng (lx)</td><td>@Fmt(latest.AnhSang)</td><td>–</td><td>–</td></tr>
        </tbody>
    </table>

    <div class="d-flex gap-2 align-items-center mb-2">
        <button class="btn btn-sm @(_historyRange is null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRangeAsync(null)">Trực tiếp</button>
        <button class="btn btn-sm @(_historyRange == HistoryRange.Hour1 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRangeAsync(HistoryRange.Hour1)">1 giờ</button>
        <button class="btn btn-sm @(_historyRange == HistoryRange.Hours24 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRangeAsync(HistoryRange.Hours24)">24 giờ</button>
        <button class="btn btn-sm @(_historyRange == HistoryRange.Days7 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRangeAsync(HistoryRange.Days7)">7 ngày</button>
    </div>
    <div class="card"><div class="card-body"><canvas id="chartHistory" height="90"></canvas></div></div>
}
else
{
    <p>Chưa nhận dữ liệu MQTT.</p>
}

@code {
    private (double lat, double lon)? _coords;
    private string? _place;
    private ApiWeather? _api;
    private CancellationTokenSource? _apiPollCts;

    [Inject] public IConfiguration Config { get; set; } = default!;

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UseMyLocation();
            await RefreshChartAsync();
            StartApiPolling();
        }
    }

    private void OnStoreChanged() => InvokeAsync(() =>
    {
        StateHasChanged();
        if (_historyRange is null) _ = RefreshChartAsync();
    });

    private async Task UseMyLocation()
    {
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("getLocation");
            _coords = (result.GetProperty("lat").GetDouble(), result.GetProperty("lon").GetDouble());
        }
        catch (JSException)
        {
            // user denied or unsupported location; fall back to the configured default
            _coords = (Config.GetValue<double>("Location:Latitude", 10.82),
                       Config.GetValue<double>("Location:Longitude", 106.63));
        }
        await RefreshApiAsync();
    }

    // Khởi chạy hẹn giờ tự động gọi lại Open-Meteo theo chu kỳ cấu hình (mặc định 5 phút)
    private void StartApiPolling()
    {
        _apiPollCts?.Cancel();
        _apiPollCts?.Dispose();
        _apiPollCts = new CancellationTokenSource();
        _ = PollApiLoopAsync(_apiPollCts.Token);
    }

    private async Task PollApiLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(OpenMeteo.RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() => RefreshApiAsync(forceRefresh: true, ct: ct));
            }
        }
        catch (OperationCanceledException)
        {
            // Dừng vòng lặp khi hủy trang
        }
        catch (ObjectDisposedException)
        {
            // Tránh lỗi khi mạch Blazor đã đóng lúc timer vừa kích hoạt
        }
    }

    private async Task RefreshApiAsync(bool forceRefresh = false, CancellationToken ct = default)
    {
        if (_coords is not { } c) return;
        _place = await OpenMeteo.GetPlaceNameAsync(c.lat, c.lon, ct) ?? _place;
        _api = await OpenMeteo.GetCurrentAsync(c.lat, c.lon, ct, forceRefresh);
        StateHasChanged();
    }

    private HistoryRange? _historyRange;

    private async Task SetRangeAsync(HistoryRange? range)
    {
        _historyRange = range;
        StateHasChanged();
        await RefreshChartAsync();
    }

    private async Task RefreshChartAsync()
    {
        IReadOnlyList<WeatherSample> hist = _historyRange is { } range
            ? await History.GetRangeAsync(range, DateTime.Now)
            : Store.History;
        var labels = hist.Select(h => _historyRange switch
        {
            HistoryRange.Hours24 => h.ReceivedAt.ToString("HH:mm"),
            HistoryRange.Days7 => h.ReceivedAt.ToString("dd/MM HH:mm"),
            _ => h.ReceivedAt.ToString("HH:mm:ss"),
        }).ToArray();
        // double.NaN is not JSON-serializable by Blazor interop; null renders as a line gap.
        _ = JS.InvokeVoidAsync("updateHistoryChart", "chartHistory", labels,
            NanToNull(hist.Select(h => h.NhietDo)),
            NanToNull(hist.Select(h => h.DoAm)),
            NanToNull(hist.Select(h => h.TocDoGio)),
            NanToNull(hist.Select(h => h.Mua)),
            NanToNull(hist.Select(h => h.AnhSang)));
    }

    private static double?[] NanToNull(IEnumerable<double> values)
        => values.Select(v => double.IsNaN(v) ? (double?)null : v).ToArray();

    private static string Fmt(double? v) => v is null or double.NaN ? "–" : v.Value.ToString("0.##");

    private static WeatherAdviceResult AdviceFor(WeatherSample s)
        => WeatherAdvice.Assess(s.NhietDo, s.AnhSang);

    private string? _aiText;
    private AiAdviceStatus _aiStatus;
    private bool _aiLoading;

    private async Task GenerateAiAdviceAsync()
    {
        if (Store.Latest is not { } latest) return;
        var advice = AdviceFor(latest);
        if (advice.Score is not { } score) return;
        _aiLoading = true;
        _aiText = null;
        StateHasChanged();
        var result = await Ai.GetAdviceAsync(latest, score, advice.Level);
        _aiStatus = result.Status;
        _aiText = result.Text;
        _aiLoading = false;
        StateHasChanged();
    }

    private static string Delta(double local, double? api)
        => double.IsNaN(local) || api is null or double.NaN ? "–" : (local - api.Value).ToString("+#0.##;-#0.##");
    private static string DeltaDeg(int local, int? api)
        => api is null ? "–" : (local - api.Value).ToString("+#0;-#0") + "°";

    private static string Compass(int deg)
    {
        string[] names = { "B", "ĐB", "Đ", "ĐN", "N", "TN", "T", "TB" };
        return names[((deg % 360) + 22) / 45 % 8];
    }

    private static string DayLabel(DateTime date)
    {
        var today = DateTime.Today;
        if (date.Date == today) return "Hôm nay";
        if (date.Date == today.AddDays(1)) return "Ngày mai";
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ hai",
            DayOfWeek.Tuesday => "Thứ ba",
            DayOfWeek.Wednesday => "Thứ tư",
            DayOfWeek.Thursday => "Thứ năm",
            DayOfWeek.Friday => "Thứ sáu",
            DayOfWeek.Saturday => "Thứ bảy",
            _ => "Chủ nhật"
        };
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        _apiPollCts?.Cancel();
        _apiPollCts?.Dispose();
    }
}
